# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server Configuration
PORT=3000
NODE_ENV=production

# Automatic HTTPS / SSL Domain (using nip.io wildcard DNS)
# Replace with your EC2 Public IPv4 (e.g. 13.233.50.12.nip.io)
DOMAIN=13.233.50.12.nip.io
